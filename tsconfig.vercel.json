{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@dreamlist/database": ["./db/vercel.ts"],
      "@dreamlist/auth": ["./lib/auth/vercel.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts",
    ".next-vercel/types/**/*.ts", ".next-vercel/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "examples", ".next", "dist", "build", "vite.config.ts", "db/cloudflare.ts"]
}
